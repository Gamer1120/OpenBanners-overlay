<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BannerOverlay"
        tools:targetApi="31">
        <service
            android:name=".OverlayService"
            android:foregroundServiceType="location" />
        <receiver android:name=".StopDetectionReceiver" />
        <receiver android:name=".HeadingOffsetReceiver" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "Start with Overlay" on openbanners.org: openbanners-overlay://banner/{id}?start=1;
                 "Start with Overlay from here" on a mission: openbanners-overlay://mission/{id}/{n}?start=1 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openbanners-overlay" android:host="banner" />
                <data android:scheme="openbanners-overlay" android:host="plan" />
                <data android:scheme="openbanners-overlay" android:host="mission" />
            </intent-filter>
        </activity>

        <!-- Settings → Links: bannergress.com banner links open on openbanners.org. Disabled until the user
             turns it on (no autoVerify: Android 12+ needs the user's OK under "Open by default"). -->
        <activity
            android:name=".BannergressLinkActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="bannergress.com" />
                <data android:host="www.bannergress.com" />
                <data android:pathPrefix="/banner/" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LicensesActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <queries>
        <package android:name="com.nianticproject.ingress" />
        <!-- The launcher, so "Only show over Ingress" ignores it -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Browsers, so Bannergress links can be handed to the default browser instead of back to this app -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
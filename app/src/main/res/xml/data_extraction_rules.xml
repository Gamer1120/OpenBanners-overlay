<?xml version="1.0" encoding="utf-8"?>
<!-- Android backup and device transfer (Android 12+): everything except a half-finished OpenBanners sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="openbanners_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="openbanners_account.xml" />
    </device-transfer>
</data-extraction-rules>
